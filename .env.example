# Root environment example for Coddy v0.2
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://user:password@db:5432/coddy
JWT_SECRET=replace-with-secure-secret
# MongoDB connection string
# Local default — replace with your Atlas URI in production
MONGODB_URI=mongodb://localhost:27017/coddy

# Secret used to sign JWT tokens — change this to a long random string before deploying
JWT_SECRET=change_me_to_a_long_random_secret

# Port the Express server listens on (optional — defaults to 5000)
PORT=5000

# ── AI code checker (OpenAI-compatible) ──────────────────────────────────────
# Provider: Groq  →  https://console.groq.com  (free tier, very fast)
# To switch provider, change both OPENAI_BASE_URL and OPENAI_API_KEY.
#
# Other popular OpenAI-compatible providers:
#   Together AI   →  https://api.together.xyz/v1
#   OpenRouter    →  https://openrouter.ai/api/v1
#   Mistral       →  https://api.mistral.ai/v1
#   DeepSeek      →  https://api.deepseek.com/v1
#   Official OpenAI → https://api.openai.com/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_groq_key_here

# Model served by the provider above
# Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, gemma2-9b-it
# OpenAI models: gpt-4o-mini, gpt-4o
AI_MODEL=llama-3.3-70b-versatile
